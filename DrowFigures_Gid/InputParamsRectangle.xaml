<Window x:Class="DrowFigures_Gid.InputParamsRectangle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrowFigures_Gid"
        mc:Ignorable="d"
        Title="InputParamsRectangle" Height="350" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Координаты точки:" Height="100" FontSize="24" TextWrapping="Wrap"/>
            <TextBlock Text="Высота:" Height="100" FontSize="24"/>
            <TextBlock Text="Ширина:" Height="100" FontSize="24"/>
            
        </StackPanel>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="X:" VerticalAlignment="Top" Height="50" Width="75" FontSize="24"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Y:" VerticalAlignment="Top" Height="50" Width="75" FontSize="24" Margin="0,50,0,0"/>
        <TextBox x:Name="T1" Grid.Column="1" HorizontalAlignment="Left" Margin="80,0,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="60" Height="50" FontSize="24"/>
        <TextBox x:Name="T2" Grid.Column="1" HorizontalAlignment="Left" Margin="80,50,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="60" Height="50" FontSize="24"/>
        <TextBox x:Name="T3" Grid.Column="1" HorizontalAlignment="Left" Margin="0,105,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="140" Height="100" FontSize="24"/>
        <TextBox x:Name="T4" Grid.Column="1" HorizontalAlignment="Left" Margin="0,202,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="140" Height="100" FontSize="24"/>
        <Button Content="Созранить и выйти" Grid.ColumnSpan="2" Margin="0,307,0,0" Click="InputParams"/>
    </Grid>
</Window>
