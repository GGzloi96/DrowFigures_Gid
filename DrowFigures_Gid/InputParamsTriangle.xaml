<Window x:Class="DrowFigures_Gid.InputParamsTriangle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrowFigures_Gid"
        mc:Ignorable="d"
        Title="InputParamsTriangle" Height="400" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="Точка 1:" Height="100" HorizontalAlignment="Center" FontSize="22" TextAlignment="Center"/>
            <TextBlock Text="Точка 2:" Height="100" HorizontalAlignment="Center" FontSize="22" TextAlignment="Center"/>
            <TextBlock Text="Точка 3:" Height="100" HorizontalAlignment="Center" FontSize="22" TextAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="X:" Height="50" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock Text="Y:" Height="50" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock Text="X:" Height="50" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock Text="Y:" Height="50" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock Text="X:" Height="50" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock Text="Y:" Height="50" FontSize="18" HorizontalAlignment="Center"/>
        </StackPanel>
        
        <StackPanel Grid.Column="2">
            <TextBox Name = "T1" Height="50"/>
            <TextBox Name = "T2" Height="50"/>
            <TextBox Name = "T3" Height="50"/>
            <TextBox Name = "T4" Height="50"/>
            <TextBox Name = "T5" Height="50"/>
            <TextBox Name = "T6" Height="50"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
            <Button Grid.ColumnSpan="3" Height="50" Content="Сохранить и выйти" Click="InputParams"/>
            <Button Grid.ColumnSpan="3" Height="50" Content="Вставить рандомные числа" Click="RandomNums"/>
        </StackPanel>
        
    </Grid>
</Window>
